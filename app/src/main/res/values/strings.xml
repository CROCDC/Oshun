<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Oshun GPS Bridge</string>

    <!-- Main screen -->
    <string name="app_subtitle">Comparte el GPS de este teléfono con Navionics en la tablet, por Wi-Fi.</string>
    <string name="label_port">Puerto</string>
    <string name="switch_tcp">TCP (servidor, 1-a-1 fiable)</string>
    <string name="switch_udp">UDP (broadcast, varios clientes)</string>
    <string name="label_interval">Intervalo de actualización</string>
    <string name="switch_autooff">Apagado automático sin clientes (15 min)</string>
    <string name="switch_rawlog">Registrar cada posición en un CSV</string>
    <string name="net_none_title">Sin red local</string>
    <string name="net_none_body">La tablet no te va a encontrar. Prendé el hotspot del teléfono (o conectate a una Wi-Fi) para poder transmitir.</string>
    <string name="net_open_hotspot">Abrir configuración de hotspot</string>
    <string name="action_start">Iniciar transmisión</string>
    <string name="action_stop">Detener</string>

    <!-- Status card -->
    <string name="status_title">Transmitiendo</string>
    <string name="status_ip">IP del teléfono</string>
    <string name="status_no_wifi">sin Wi-Fi</string>
    <string name="status_port">Puerto</string>
    <string name="status_protocols">Protocolos</string>
    <string name="status_protocols_none">ninguno</string>
    <string name="status_tcp_clients">Clientes TCP</string>
    <string name="status_sentences">Sentencias enviadas</string>
    <string name="status_last_position">Última posición</string>
    <string name="status_battery">Batería</string>
    <string name="status_draw">Consumo estimado</string>
    <string name="status_drain">Caída de batería</string>
    <string name="status_last_fix">Último fix del GPS</string>
    <string name="status_last_send">Último envío a un cliente</string>
    <string name="status_heartbeats">Reenvíos (heartbeat)</string>
    <string name="status_never">nunca</string>
    <!-- %1$s: "12 s", "3 min 07 s", "1 h 04 min" -->
    <string name="status_age">hace %1$s</string>
    <string name="status_delivery">Entrega</string>

    <!-- Resultado de cada envío -->
    <string name="outcome_ok">Entregado a un cliente</string>
    <string name="outcome_no_client">Sin cliente: no salió del teléfono</string>
    <string name="outcome_stalled">Trabado: se envía y no lo consumen</string>
    <string name="outcome_dropped">Se cortó la conexión</string>
    <string name="outcome_blind">UDP: salió, sin confirmación posible</string>
    <string name="outcome_not_sent">Sin transporte activo</string>
    <string name="outcome_unknown">todavía sin datos</string>

    <string name="status_fix_stale">Fix viejo: se transmite marcado como inválido (RMC \"V\").</string>

    <!-- Diagnostics / power banners -->
    <string name="idle_banner_title">El puente se había apagado solo</string>
    <string name="idle_banner_body">No hubo ningún cliente TCP conectado durante 15 minutos y se apagó para ahorrar batería. Si Navionics se te quedó con una posición vieja, fue por esto: podés desactivar el apagado automático más abajo.</string>
    <string name="idle_banner_dismiss">Entendido</string>
    <string name="battery_banner_title">Optimización de batería activada</string>
    <string name="battery_banner_body">Android puede frenar la app con la pantalla apagada.</string>
    <string name="battery_banner_action">Excluir a Oshun</string>

    <!-- Registro -->
    <string name="log_open">Ver registro</string>
    <string name="log_title">Registro</string>
    <string name="log_subtitle">Qué cambió y cuándo. El detalle posición por posición va al CSV.</string>
    <!-- %1$s: tamaño, p. ej. "1,2 MB" -->
    <string name="log_file_size">Archivo CSV: %1$s</string>
    <string name="log_share">Compartir CSV</string>
    <string name="log_clear">Borrar</string>
    <string name="log_empty">Todavía no hay eventos. Iniciá la transmisión.</string>
    <string name="log_share_empty">Todavía no hay nada para compartir.</string>
    <!-- %1$s: protocolos y puerto, p. ej. "TCP:2000" -->
    <string name="log_session_start">Sesión iniciada (%1$s)</string>
    <!-- %1$s: motivo -->
    <string name="log_session_stop">Sesión detenida (%1$s)</string>
    <string name="log_stop_user">manual</string>
    <string name="log_stop_idle">apagado automático</string>
    <!-- %1$s: IP del cliente -->
    <string name="log_client_connected">Cliente conectado: %1$s</string>
    <string name="log_client_disconnected">Cliente desconectado: %1$s</string>
    <string name="log_fix_ok">GPS al día</string>
    <string name="log_fix_stale">Fix viejo: se transmite como inválido</string>

    <!-- Instructions card -->
    <string name="instructions_title">En la tablet (Navionics)</string>
    <string name="instructions_body">1. Conecta la tablet a la misma red Wi-Fi que este teléfono (o al hotspot del teléfono).\n2. Navionics → Menú → Paired Devices → Add device manually.\n3. Host/IP = la IP de arriba, Port = el puerto, Protocol = TCP o UDP.\n4. Guarda: la posición del teléfono aparece en la carta.</string>

    <!-- Crash screen -->
    <string name="crash_title">La app se cerró de forma inesperada</string>
    <string name="crash_subtitle">Copiá o compartí este detalle y pasámelo así lo arreglamos.</string>
    <string name="crash_copy">Copiar</string>
    <string name="crash_share">Compartir</string>
    <string name="crash_restart">Reiniciar app</string>
    <string name="crash_copied">Copiado al portapapeles</string>
    <string name="crash_none">Sin datos de crash.</string>
    <string name="crash_banner_title">Se detectó un cierre inesperado</string>
    <string name="crash_banner_view">Ver detalle</string>
    <string name="crash_banner_dismiss">Descartar</string>

    <!-- Foreground-service notification -->
    <string name="notif_title">Oshun GPS Bridge activo</string>
    <string name="notif_channel_name">Oshun GPS Bridge</string>
    <string name="notif_channel_desc">Transmisión de GPS por NMEA a Navionics</string>
    <string name="notif_protocols_none">—</string>
    <!-- %1$s ip, %2$d port, %3$s protocols -->
    <string name="notif_content">%1$s:%2$d · %3$s</string>
    <!-- %1$s ip, %2$d port, %3$s protocols, %4$d tcp clients -->
    <string name="notif_content_clients">%1$s:%2$d · %3$s · %4$d cliente(s)</string>
    <string name="notif_autooff_title">Oshun se apagó solo</string>
    <!-- %1$d: minutos del watchdog -->
    <string name="notif_autooff_text">Sin clientes TCP por %1$d min. Tocá para volver a iniciar.</string>
</resources>
