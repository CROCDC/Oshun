    <!-- Diagnostics / power banners -->
    <string name="idle_banner_title">El puente se había apagado solo</string>
    <string name="idle_banner_body">No hubo ningún cliente TCP conectado durante 15 minutos y se apagó para ahorrar batería. Si Navionics se te quedó con una posición vieja, fue por esto: podés desactivar el apagado automático más abajo.</string>
    <string name="idle_banner_dismiss">Entendido</string>
    <string name="battery_banner_title">Optimización de batería activada</string>
    <string name="battery_banner_body">Android puede frenar la app con la pantalla apagada.</string>
    <string name="battery_banner_action">Excluir a Oshun</string>

    <!-- Modo prueba -->
    <string name="sim_title">Modo prueba</string>
    <string name="sim_body">Transmite un barco simulado navegando en el Río de la Plata entre dos puntos separados 12 M, a 4 nudos (3 h por tramo, ida y vuelta). Sirve para probar Navionics de punta a punta sin salir al agua. Lo que sale por la red es idéntico a una navegación real: el aviso está acá, en el registro y en la notificación.</string>
    <string name="switch_sim">Transmitir barco simulado</string>
    <string name="sim_ais">Además transmite dos barcos AIS de prueba: un carguero a 12 nudos que cruza tu rumbo por el medio del tramo, y una lancha de pesca a 3 nudos cerca del primer waypoint. Sirven para ver si Navionics dibuja los targets. Se llaman TEST y sus MMSI no pertenecen a nadie.</string>

