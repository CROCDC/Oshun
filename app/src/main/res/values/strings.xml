<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Oshun GPS Bridge</string>

    <!-- Main screen -->
    <string name="app_subtitle">Comparte el GPS de este teléfono con Navionics en la tablet, por Wi-Fi.</string>
    <string name="label_port">Puerto</string>
    <string name="switch_tcp">TCP (servidor, 1-a-1 fiable)</string>
    <string name="switch_udp">UDP (broadcast, varios clientes)</string>
    <string name="label_interval">Intervalo de actualización</string>
    <string name="switch_autooff">Apagado automático sin clientes (15 min)</string>
    <string name="switch_rawlog">Registrar cada posición en un CSV</string>
    <string name="net_req_title">Cómo se conectan los dos aparatos</string>
    <string name="net_req_body">Hay dos enlaces que zarpan con vos y cualquiera de los dos sirve igual: el hotspot del teléfono o un cable USB entre los dos aparatos. Por el que elijas va todo — la posición y los targets AIS van por la misma conexión. Lo que no sirve es una Wi-Fi ajena: en la amarra el Wi-Fi del club alcanza a los dos aparatos y parece que anda, pero a los pocos metros te quedás sin red y la carta se congela.</string>
    <string name="net_req_cable">Cable USB entre el teléfono y la tablet</string>
    <string name="net_req_or">— o bien —</string>
    <string name="net_req_cable_hint">Con el cable puesto, prendé «Anclaje por USB» en el teléfono. No todas las tablets lo reconocen; si la tuya no, el hotspot hace exactamente lo mismo.</string>
    <string name="net_req_body_sim">En modo prueba alcanza con que el teléfono y la tablet estén en la misma red: la corrida no sale del escritorio. Prendé el hotspot o conectate a una Wi-Fi.</string>
    <string name="net_req_any">Alguna red local disponible</string>
    <string name="net_req_hotspot">Hotspot del teléfono encendido</string>
    <string name="net_req_wifi_off">Wi-Fi del teléfono apagado</string>
    <!-- %1$s: el requisito -->
    <string name="net_req_ok">✓ %1$s</string>
    <string name="net_req_missing">✗ %1$s</string>
